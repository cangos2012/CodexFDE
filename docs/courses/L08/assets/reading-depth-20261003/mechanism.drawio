<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="L08" name="从整单计划到共同提交或回滚">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="880" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="L08｜从整单计划到共同提交或回滚" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#17252b;spacing=0;fontSize=32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="30" width="1420" height="55" />
        </mxCell>
        <mxCell id="question" value="库存都够，为什么仍要验证中途写入失败？" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#17252b;spacing=0;fontSize=23;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="100" width="1420" height="45" />
        </mxCell>
        <mxCell id="step-0" value="&lt;b&gt;01 先形成完整预占计划&lt;/b&gt;&lt;br&gt;&lt;br&gt;A、B各可用5，订单需2与3；&lt;br&gt;若B只有2，计划阶段拒绝。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="step-1" value="&lt;b&gt;02 事务内先写入A&lt;/b&gt;&lt;br&gt;&lt;br&gt;同一连接内A暂时可用3，&lt;br&gt;有一条预占；整单尚未提交。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="410" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#517b94;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step-0" target="step-1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step-2" value="&lt;b&gt;03 继续B并保留失败&lt;/b&gt;&lt;br&gt;&lt;br&gt;B需3；第二条预占插入故&lt;br&gt;障必须到达回滚分支。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#517b94;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step-1" target="step-2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step-3" value="&lt;b&gt;04 整单提交或回滚&lt;/b&gt;&lt;br&gt;&lt;br&gt;成功可用3与2、订单&lt;br&gt;reserved；失败可用5与5、&lt;br&gt;四表不变。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#517b94;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step-2" target="step-3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="counterexample" value="&lt;b&gt;预检查不能覆盖写入错误&lt;/b&gt;&lt;br&gt;&lt;br&gt;库存足够仍可写入失败；逐行提交会把A的预占留下。" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=23;spacing=20;strokeWidth=2;fillColor=#fff0ef;strokeColor=#b7625b;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="500" width="680" height="180" />
        </mxCell>
        <mxCell id="judgment" value="&lt;b&gt;读提交或回滚后的四表&lt;/b&gt;&lt;br&gt;&lt;br&gt;失败保持confirmed且四表不变；正常路径必须能成功。" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=23;spacing=20;strokeWidth=2;fillColor=#eef7f1;strokeColor=#56846a;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="500" width="680" height="180" />
        </mxCell>
        <mxCell id="transfer" value="&lt;b&gt;先确认整批还是逐行&lt;/b&gt;　整批导入先确认失败规则，再确定事务边界与三类检查。" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=23;spacing=20;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#788186;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="740" width="1420" height="95" />
        </mxCell>
        <mxCell id="legend" value="蓝色：机制步骤　　红色：错误推断或反例　　绿色：判断条件　　灰色：迁移　｜　教学示意" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#17252b;spacing=0;fontSize=18;fontColor=#526168;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="850" width="1420" height="35" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>