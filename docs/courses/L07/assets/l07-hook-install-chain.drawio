<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="安装与验证链路">
    <mxGraphModel page="1" pageScale="1" pageWidth="1100" pageHeight="1320" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;div style=&quot;font-size:32px;line-height:1.45;font-weight:bold;&quot;&gt;L07｜把 Stop Hook 接入 Codex 的完整链路&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1020" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;6.1  确认实际候选与解释器&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;位置：第 5 节任务返回的实际候选目录&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;产出：候选绝对路径 + 可运行的 Python&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="100" y="180" width="900" height="120" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;6.2  审查 hook_staging 中的两份文件&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;位置：hook_staging/hooks.json 与 quality_gate.py&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;核对：Stop、处理器路径、解释器与检查命令&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="100" y="330" width="900" height="120" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;6.3  安装到候选的 .codex 目录&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;位置：.codex/hooks.json 与 .codex/hooks/quality_gate.py&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;产出：安装后文件与指纹；已有配置先备份再合并&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="100" y="480" width="900" height="120" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;6.4  在候选启动 Codex CLI，用 /hooks 信任&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;位置：该候选目录中的交互会话&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;产出：项目来源、执行命令与已信任状态&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="100" y="630" width="900" height="120" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;6.5  只读结束，触发真实 Stop 发现错误&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;位置：保留金额缺陷的候选 + Codex 会话&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;产出：金额错误 → 阻断理由 + 续跑记录&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="100" y="780" width="900" height="120" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;6.6  修复、显式复验，再获 Stop 通过&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;位置：同一候选；修复金额公式后重跑原检查&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;产出：显式 Eval 绿 + 新一轮正常 Stop 的绿&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="100" y="930" width="900" height="120" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;6.7  交接四类证据并具名审核&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;交接：最终配置 / 会话 / 报告 / 审核记录&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;判断：指纹与候选一致；缺项保持待完成&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="100" y="1080" width="900" height="120" as="geometry" />
        </mxCell>
