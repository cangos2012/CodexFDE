<mxfile host="drawio" version="26.0.0">
  <diagram name="事件与质量检查因果">
    <mxGraphModel page="1" pageScale="1" pageWidth="1100" pageHeight="1320" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;div style=&quot;font-size:32px;line-height:1.45;font-weight:bold;&quot;&gt;L07｜真实 Stop 事件怎样变成质量护栏&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1020" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;div style=&quot;font-size:27px;line-height:1.45;font-weight:bold;&quot;&gt;Codex 准备结束当前轮次&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;事件：Stop&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="240" y="180" width="620" height="90" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;匹配已加载的项目 Stop 规则&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;前提：该候选的项目 Hook 已审查并信任&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="170" y="330" width="760" height="110" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;启动 .codex/hooks/quality_gate.py&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;位置：处理器归属的同一候选目录&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="170" y="500" width="760" height="110" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;用同候选解释器运行统一检查&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;python -X utf8 -m eval.harness --suite blocking&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="170" y="670" width="760" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;失败：decision: block&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;将原因返回 Codex&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;Codex 收到续跑原因；按原授权继续&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="70" y="900" width="450" height="130" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;成功：continue: true&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;允许本轮结束&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;保留实际报告与候选来源&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="580" y="900" width="450" height="130" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;div style=&quot;font-size:26px;line-height:1.45;font-weight:bold;&quot;&gt;重入跳过不等于修复&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;stop_hook_active=true 时，参考实现跳过检查。&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.45;&quot;&gt;先显式复验，再取得新一轮正常 Stop 的通过记录。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontColor=#20354A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
