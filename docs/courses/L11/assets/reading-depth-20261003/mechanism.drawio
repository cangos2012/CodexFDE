          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step-3" value="&lt;b&gt;04 重新划分任务&lt;/b&gt;&lt;br&gt;&lt;br&gt;测试补全与只读风险审查共&lt;br&gt;享固定 V2，主 Agent 整&lt;br&gt;合复验。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
