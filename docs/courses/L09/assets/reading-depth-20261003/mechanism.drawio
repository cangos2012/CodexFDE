<mxfile host="drawio" version="26.0.0">
  <diagram id="L09" name="L09｜三个差异，一条取消动作链">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="880" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="L09｜三个差异，一条取消动作链" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#17252b;spacing=0;fontSize=32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="30" width="1420" height="55" />
        </mxCell>
        <mxCell id="question" value="三项失败是否来自同一次漏释放？" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#17252b;spacing=0;fontSize=23;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="100" width="1420" height="45" />
        </mxCell>
        <mxCell id="step-0" value="&lt;b&gt;01 固定候选 V0&lt;/b&gt;&lt;br&gt;&lt;br&gt;TARGET 已取消；A/B 总&lt;br&gt;预占仍为 6/4。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="step-1" value="&lt;b&gt;02 保留三个差异&lt;/b&gt;&lt;br&gt;&lt;br&gt;预占 6/4、可用 4/4、&lt;br&gt;TARGET 释放流水缺失。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="410" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#517b94;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step-0" target="step-1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step-2" value="&lt;b&gt;03 追踪共同动作&lt;/b&gt;&lt;br&gt;&lt;br&gt;只读核对取消调用链，确认&lt;br&gt;释放分支为何未执行。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#517b94;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step-1" target="step-2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step-3" value="&lt;b&gt;04 形成一次受控修复&lt;/b&gt;&lt;br&gt;&lt;br&gt;预占恢复 2/1，可用 8/7；&lt;br&gt;补齐两条释放流水。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#517b94;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step-2" target="step-3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="counterexample" value="&lt;b&gt;只改查询显示&lt;/b&gt;&lt;br&gt;&lt;br&gt;页面可用变为 8/7，数据库仍预占 6/4，业务依旧错误。" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=23;spacing=20;strokeWidth=2;fillColor=#fff0ef;strokeColor=#b7625b;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="500" width="680" height="180" />
        </mxCell>
        <mxCell id="judgment" value="&lt;b&gt;合并依据&lt;/b&gt;&lt;br&gt;&lt;br&gt;共同原因和最小写集有证据，原有三项要求全部复验。" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=23;spacing=20;strokeWidth=2;fillColor=#eef7f1;strokeColor=#56846a;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="500" width="680" height="180" />
        </mxCell>
        <mxCell id="transfer" value="&lt;b&gt;迁移到采购理由&lt;/b&gt;　查询与导出都为空，先查保存，再判断共同或不同原因。" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=23;spacing=20;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#788186;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="740" width="1420" height="95" />
        </mxCell>
        <mxCell id="legend" value="蓝色：机制步骤　　红色：错误推断或反例　　绿色：判断条件　　灰色：迁移　｜　教学示意" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#17252b;spacing=0;fontSize=18;fontColor=#526168;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="850" width="1420" height="35" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
