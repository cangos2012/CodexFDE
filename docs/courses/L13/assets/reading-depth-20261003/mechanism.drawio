<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="L13" name="L13｜超时之后，先找回原任务">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="880" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="L13｜超时之后，先找回原任务" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#17252b;spacing=0;fontSize=32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="30" width="1420" height="55" />
        </mxCell>
        <mxCell id="question" value="同一个超时提示，为什么需要不同的恢复动作？" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#17252b;spacing=0;fontSize=23;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="100" width="1420" height="45" />
        </mxCell>
        <mxCell id="step-0" value="&lt;b&gt;01 保留原请求&lt;/b&gt;&lt;br&gt;&lt;br&gt;沿用 L13-original、原&lt;br&gt;内容与请求者" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="step-1" value="&lt;b&gt;02 一起提交受理事实&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务、受理事件与键映射在&lt;br&gt;事务中保存" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="410" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#517b94;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step-0" target="step-1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step-2" value="&lt;b&gt;03 响应可能丢失&lt;/b&gt;&lt;br&gt;&lt;br&gt;原键重试找回原 ID，不增&lt;br&gt;加任务数量" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#517b94;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step-1" target="step-2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step-3" value="&lt;b&gt;04 核对执行副作用&lt;/b&gt;&lt;br&gt;&lt;br&gt;代码执行中断：查原任务、&lt;br&gt;Diff 与残留进程" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#517b94;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step-2" target="step-3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="counterexample" value="&lt;b&gt;错误推断&lt;/b&gt;&lt;br&gt;&lt;br&gt;只有一个 Task，就自动再执行一次。任务数量不变，源&lt;br&gt;码却可能被重复修改。" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=23;spacing=20;strokeWidth=2;fillColor=#fff0ef;strokeColor=#b7625b;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="500" width="680" height="180" />
        </mxCell>
        <mxCell id="judgment" value="&lt;b&gt;完成判断&lt;/b&gt;&lt;br&gt;&lt;br&gt;原键找回身份；同键异内容拒绝；中断写入保留原因并等&lt;br&gt;人核对。" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=23;spacing=20;strokeWidth=2;fillColor=#eef7f1;strokeColor=#56846a;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="500" width="680" height="180" />
        </mxCell>
        <mxCell id="transfer" value="&lt;b&gt;迁移到批量通知&lt;/b&gt;　任务受理一次与每个收件人收到一次，分别设计副作用检查。" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=23;spacing=20;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#788186;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="740" width="1420" height="95" />
        </mxCell>
        <mxCell id="legend" value="蓝色：机制步骤　　红色：错误推断或反例　　绿色：判断条件　　灰色：迁移　｜　教学示意" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#17252b;spacing=0;fontSize=18;fontColor=#526168;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="850" width="1420" height="35" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>