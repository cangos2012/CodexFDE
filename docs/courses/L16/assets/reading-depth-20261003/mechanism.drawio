<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="L16" name="L16｜让验收能区分错误方案">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="880" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="L16｜让验收能区分错误方案" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#17252b;spacing=0;fontSize=32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="30" width="1420" height="55" />
        </mxCell>
        <mxCell id="question" value="搜索框能用，怎样证明查到本组织全部库存？" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#17252b;spacing=0;fontSize=23;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="100" width="1420" height="45" />
        </mxCell>
        <mxCell id="step-0" value="&lt;b&gt;01 固定起点与对象&lt;/b&gt;&lt;br&gt;&lt;br&gt;蓝色螺栓在第 2 页；外组&lt;br&gt;织有同名商品" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="step-1" value="&lt;b&gt;02 检查跨页目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;只加载第 1 页，查询螺栓&lt;br&gt;仍找到本组织 ID" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="410" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#517b94;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step-0" target="step-1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step-2" value="&lt;b&gt;03 检查组织边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;原始 API 响应与页面包含&lt;br&gt;本组织目标，不含外组织 &lt;br&gt;ID" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#517b94;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step-1" target="step-2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step-3" value="&lt;b&gt;04 核对只读状态&lt;/b&gt;&lt;br&gt;&lt;br&gt;查询前后库存、预占和账本&lt;br&gt;都不变" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=22;spacing=18;strokeWidth=2;fillColor=#edf5fa;strokeColor=#517b94;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="190" width="310" height="240" />
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#517b94;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="step-2" target="step-3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="counterexample" value="&lt;b&gt;单页演示的盲点&lt;/b&gt;&lt;br&gt;&lt;br&gt;只用一页、一个组织的数据，前端过滤与错误的全库查询&lt;br&gt;都可能看起来正确。" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=23;spacing=20;strokeWidth=2;fillColor=#fff0ef;strokeColor=#b7625b;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="500" width="680" height="180" />
        </mxCell>
        <mxCell id="judgment" value="&lt;b&gt;同一候选整组复验&lt;/b&gt;&lt;br&gt;&lt;br&gt;跨页、权限与只读各自成立；修订后重跑整组，保留真实&lt;br&gt;结果与人审。" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=23;spacing=20;strokeWidth=2;fillColor=#eef7f1;strokeColor=#56846a;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="500" width="680" height="180" />
        </mxCell>
        <mxCell id="transfer" value="&lt;b&gt;迁移到销售订单&lt;/b&gt;　沿用检查布置方法，重新确定订单 ID、筛选与状态合同。" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontColor=#17252b;fontSize=23;spacing=20;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#788186;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="740" width="1420" height="95" />
        </mxCell>
        <mxCell id="legend" value="蓝色：机制步骤　　红色：错误推断或反例　　绿色：判断条件　　灰色：迁移　｜　教学示意" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#17252b;spacing=0;fontSize=18;fontColor=#526168;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="850" width="1420" height="35" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>