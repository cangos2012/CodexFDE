  <diagram id="核心对象逻辑关系" name="核心对象逻辑关系">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1660" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="核心对象怎样组成一个研发事项（逻辑关系）" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#243746;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1840" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="项目决定在哪里做、如何检查；事项持续保留目标与轮次；任务承载一轮执行、检查和人审。" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243746;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
