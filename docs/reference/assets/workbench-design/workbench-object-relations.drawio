        <mxCell id="learning-title" value="前事项的经验，怎样成为后事项这一轮的输入" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243746;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1">
