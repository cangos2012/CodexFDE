          <mxGeometry x="50" y="1360" width="1770" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ownership-db" value="&lt;b&gt;workbench.db&lt;/b&gt;&lt;br&gt;项目、事项、方案 / 轮次、任务状态与关联&lt;br&gt;经验版本、采用绑定及阶段记录" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243746;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
