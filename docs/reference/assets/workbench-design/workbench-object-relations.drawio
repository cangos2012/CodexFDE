        <mxCell id="durable-note" value="事项是长期容器：一次返工或一轮任务结束，仍可在同一事项里修订方案并继续下一轮。&lt;br&gt;&lt;br&gt;任务及采用快照记录的是具体轮次；软件接受候选、源码集成和客户业务状态各有独立证据。" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243746;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1130" width="1270" height="160" as="geometry" />
        </mxCell>
