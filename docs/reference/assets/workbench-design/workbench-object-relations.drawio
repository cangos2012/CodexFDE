        </mxCell>
        <mxCell id="source" value="&lt;b&gt;前事项来源任务 / 反馈&lt;/b&gt;&lt;br&gt;成功任务已具名验收&lt;br&gt;失败需已接受反馈与改进提案" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b4d;spacing=14;fontSize=18;" vertex="1" parent="1">
