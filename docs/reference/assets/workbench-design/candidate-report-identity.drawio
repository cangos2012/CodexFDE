<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" version="31.4.4">
  <diagram id="candidate-report-identity" name="候选与报告怎样保持对应">
    <mxGraphModel dx="1300" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1300" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;同一份候选，怎样对应检查、接受与集成&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#243746;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1180" height="55" />
        </mxCell>
        <mxCell id="3" value="A 是本事项的源码起点；B 是隔离副本。每一步都要核对依据是否仍然有效。" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243746;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="85" width="1180" height="40" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;原项目源码 A&lt;/b&gt;&lt;br&gt;记录本事项起点&lt;br&gt;保留受控源码清单" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b4d;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="160" width="300" height="130" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;复制隔离候选 B&lt;/b&gt;&lt;br&gt;从 A 建立源码副本&lt;br&gt;原项目先保持原状" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b4d;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="460" y="160" width="300" height="130" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;Codex 修改候选 B&lt;/b&gt;&lt;br&gt;按本轮授权范围实现&lt;br&gt;保留实际变化与补丁" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b4d;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="880" y="160" width="300" height="130" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;① 在 B 中运行检查&lt;/b&gt;&lt;br&gt;读取 B 的真实源码&lt;br&gt;核对检查期间源码未变&lt;br&gt;保存退出码与分项结果" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b4d;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="880" y="430" width="300" height="160" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;报告关联 B 的内容指纹&lt;/b&gt;&lt;br&gt;保存报告文件哈希&lt;br&gt;指向本次检查的候选&lt;br&gt;通过结果进入人审" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b4d;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="460" y="430" width="300" height="160" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;② 人接受候选 B&lt;/b&gt;&lt;br&gt;核对 B 仍是检查时内容&lt;br&gt;核对报告文件未变&lt;br&gt;记录具名决定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b4d;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="430" width="300" height="160" />
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;③ 另行集成前核对&lt;/b&gt;&lt;br&gt;B 仍是接受时内容&lt;br&gt;原项目仍是起点 A&lt;br&gt;累计改动仍在授权范围" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b4d;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="740" width="300" height="160" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;核对通过，再确认写回&lt;/b&gt;&lt;br&gt;把接受过的候选集成到原项目&lt;br&gt;保留补丁与集成记录&lt;br&gt;Git 提交、部署继续办理" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b4d;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="460" y="740" width="300" height="160" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;检查后 B 又改动&lt;/b&gt;&lt;br&gt;旧报告失效，不能据此接受&lt;br&gt;保留旧结果，重新检查" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b4d;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="880" y="740" width="300" height="160" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;原项目 A 已变化&lt;/b&gt;&lt;br&gt;停止集成，保留候选&lt;br&gt;人工核对起点与冲突" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#172b4d;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1060" width="300" height="120" />
        </mxCell>
        <mxCell id="14" value="复制本轮源码" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#526d82;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243746;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5">
