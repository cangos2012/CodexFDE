        <mxCell id="b" value="事项 B：显式采用版本，验证是否真的有效" style="swimlane;startSize=45;horizontal=1;rounded=1;arcSize=4;html=1;container=1;pointerEvents=0;fillColor=#f6f9fd;swimlaneFillColor=#ffffff;strokeColor=#9aafc6;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=20;fontStyle=1;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="1730" height="440" as="geometry" />
        </mxCell>
        <mxCell id="recall" value="&lt;b&gt;按项目与边界召回&lt;/b&gt;&lt;br&gt;人逐项采用或拒绝&lt;br&gt;保存理由与版本绑定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b4d;spacing=14;" vertex="1" parent="b">
          <mxGeometry x="30" y="70" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="spec" value="&lt;b&gt;冻结 Spec 与采用快照&lt;/b&gt;&lt;br&gt;绑定目标、写集、版本哈希&lt;br&gt;失效版本不可继续沿用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b4d;spacing=14;" vertex="1" parent="b">
          <mxGeometry x="460" y="70" width="390" height="130" as="geometry" />
        </mxCell>
        <mxCell id="execute" value="&lt;b&gt;固定四阶段执行&lt;/b&gt;&lt;br&gt;前置检查 → 实现 → Eval → 人审&lt;br&gt;逐阶段保留实际检查与候选证据" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b4d;spacing=14;" vertex="1" parent="b">
          <mxGeometry x="910" y="70" width="780" height="130" as="geometry" />
        </mxCell>
        <mxCell id="outcome" value="&lt;b&gt;记录人审及实际采用结果&lt;/b&gt;&lt;br&gt;通过：具名验收 + 检查证据完整&lt;br&gt;失败：保留失败轨迹与原因" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b4d;spacing=14;" vertex="1" parent="b">
          <mxGeometry x="1100" y="270" width="590" height="130" as="geometry" />
        </mxCell>
        <mxCell id="govern" value="&lt;b&gt;发布、修订或停用版本&lt;/b&gt;&lt;br&gt;流程试用通过后，由人具名发布&lt;br&gt;流程复用失败即停用；记忆可由人撤回" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b4d;spacing=14;fontSize=18;" vertex="1" parent="b">
          <mxGeometry x="510" y="270" width="510" height="130" as="geometry" />
        </mxCell>
        <mxCell id="next" value="&lt;b&gt;后续事项再次采用&lt;/b&gt;&lt;br&gt;继续检验适用性与交付效果&lt;br&gt;保留新事项与旧版本的关联" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b4d;spacing=14;" vertex="1" parent="b">
