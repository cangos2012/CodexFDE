  <diagram id="跨事项经验与流程复用" name="跨事项经验与流程复用">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1830" pageHeight="1330" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="能力如何增长：让前一事项的经验接受后一事项检验" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#243746;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1750" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Harness 控制交付；记忆保留有边界的经验；工作流从真实轨迹提炼，并经复验和人审后复用。" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243746;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="1750" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a" value="事项 A：真实交付产生可核查的来源" style="swimlane;startSize=45;horizontal=1;rounded=1;arcSize=4;html=1;container=1;pointerEvents=0;fillColor=#f6f9fd;swimlaneFillColor=#ffffff;strokeColor=#9aafc6;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=20;fontStyle=1;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="1730" height="260" as="geometry" />
        </mxCell>
        <mxCell id="delivery-a" value="&lt;b&gt;受控交付、失败与已接受反馈&lt;/b&gt;&lt;br&gt;保留任务、Spec、Diff、Eval&lt;br&gt;及实际人审或失败轨迹" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b4d;spacing=14;fontSize=18;" vertex="1" parent="a">
          <mxGeometry x="30" y="80" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="candidate" value="&lt;b&gt;提炼记忆 / 流程候选&lt;/b&gt;&lt;br&gt;来源快照 · 项目 · 适用边界&lt;br&gt;排除条件 · 版本与哈希" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b4d;spacing=14;" vertex="1" parent="a">
          <mxGeometry x="460" y="80" width="390" height="130" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;独立审核候选&lt;/b&gt;&lt;br&gt;审核人须与提炼者分离&lt;br&gt;核查来源与采用边界" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b4d;spacing=14;" vertex="1" parent="a">
          <mxGeometry x="910" y="80" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="version" value="&lt;b&gt;可召回的版本&lt;/b&gt;&lt;br&gt;记忆已生效&lt;br&gt;流程经审核可试用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#172b4d;spacing=14;" vertex="1" parent="a">
